# Managed by the K2NET Ansible WireGuard role.
advanced:
  start_listen_port: {{ wireguard_listen_port }}
  start_cidr_v4: {{ wireguard_vpn_cidr }}
  use_ip_v6: {{ wireguard_enable_ipv6 | lower }}
  config_storage_path: "/etc/wireguard"

core:
  admin_user: {{ wireguard_admin_user | to_json }}
  import_existing: true
  restore_state: true
  create_default_peer_on_login: false
  create_default_peer_on_user_creation: false
  create_default_peer_on_interface_creation: false

database:
  type: sqlite
  dsn: /app/data/sqlite.db

web:
  listening_address: {{ (wireguard_web_listen_address ~ ':' ~ wireguard_web_port) | to_json }}
  external_url: {{ wireguard_external_url | to_json }}
  site_company_name: {{ wireguard_site_company_name | to_json }}
  site_title: {{ wireguard_site_title | to_json }}
  request_logging: false
  expose_host_info: false
